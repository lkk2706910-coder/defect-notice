<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    connections.config is gitignored (contains real DB credentials).
    Copy connections.config.sample -> connections.config on the deployed
    server and fill in the real connection string.
  -->
  <connectionStrings configSource="connections.config" />
  <system.web>
    <httpRuntime maxRequestLength="51200" executionTimeout="120" />
  </system.web>
</configuration>
