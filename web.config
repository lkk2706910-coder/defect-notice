<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- LOSSREASON 查詢用,?op=lookupReason 透過這條 connection 查
         [GPTPoCDB].[dbo].[Notes_Scrap_RawCat] 的 LOT/LOSSREASON。
         走 SQL 帳號驗證連 UMCESIDB02。表用完整三段式名稱查詢,所以
         即使預設 Database 是 GPTPoCDB 也能跨庫讀取(前提:目標表在同
         一台 UMCESIDB02,且此帳號對它有讀取權限)。
         如果要改回 Windows 整合驗證:
           connectionString="Data Source=UMCESIDB02;Initial Catalog=GPTPoCDB;Integrated Security=True"
    -->
    <add name="GPTPoCDB"
         connectionString="Server=UMCESIDB02;Database=GPTPoCDB;User Id=GPTPoCDBUser;Password=DB02.2026;Connection Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- AI assistant gateway. The api-key MUST NOT be committed.
         Fill the real value in the deployed web.config only. -->
    <add key="AiGatewayUrl" value="http://10.11.197.97/openai/deployments/gpt-5.2/chat/completions" />
    <add key="AiApiKey" value="" />
    <add key="AiUserId" value="" />
    <add key="AiSystemPrompt" value="你是設備工程小助手,協助使用者查詢與整理 defect lesson learn。回答請精簡、條列重點。" />
  </appSettings>
  <system.web>
    <!-- Raise upload size to 50 MB and request timeout to 2 minutes -->
    <!-- Base64-encoded wafer / defect images make request bodies large. -->
    <httpRuntime maxRequestLength="51200" executionTimeout="120" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- IIS-level cap (bytes). Must be >= maxRequestLength * 1024. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
